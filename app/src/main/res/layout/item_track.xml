<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- название сжимается с многоточием, отметка «в любимых» стоит сразу за ним -->
    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textColor="#F3F1FA"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/cover"
        app:layout_constraintEnd_toStartOf="@id/rowLiked"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rowArtist" />

    <ImageView
        android:id="@+id/rowLiked"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_check"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/rowTitle"
        app:layout_constraintEnd_toStartOf="@id/rowEq"
        app:layout_constraintTop_toTopOf="@id/rowTitle"
        app:layout_constraintBottom_toBottomOf="@id/rowTitle" />

    <TextView
        android:id="@+id/rowArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:textColor="#A09CB8"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/cover"
        app:layout_constraintEnd_toStartOf="@id/rowEq"
        app:layout_constraintTop_toBottomOf="@id/rowTitle"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/rowEq"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_eq"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/rowShare"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/rowShare"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="10dp"
        android:src="@drawable/ic_upload"
        android:contentDescription="Поделиться"
        app:tint="#1DB954"
        app:layout_constraintEnd_toStartOf="@id/rowAdd"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/rowAdd"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="10dp"
        android:src="@drawable/ic_playlist"
        android:contentDescription="Добавить в плейлист"
        app:layout_constraintEnd_toStartOf="@id/rowMore"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/rowMore"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="7dp"
        android:src="@drawable/ic_more"
        android:contentDescription="Ещё"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
