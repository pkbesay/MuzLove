<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/npOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0913"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="34dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:id="@+id/npClose"
            android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp"
            android:src="@drawable/ic_chevron_down" app:tint="#FFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="СЕЙЧАС ИГРАЕТ" android:textColor="#B3FFFFFF" android:textSize="11sp"
                android:textStyle="bold" android:letterSpacing="0.1" />
            <TextView android:id="@+id/npAlbum" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="2dp" />
        </LinearLayout>
        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <View android:id="@+id/npCover" android:layout_width="300dp" android:layout_height="300dp" android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/npTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/npArtist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#BFFFFFFF" android:textSize="15sp" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/npLike" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="6dp" android:src="@drawable/ic_heart" app:tint="#FFFFFF" />
    </LinearLayout>

    <com.example.muzlove.WaveformView android:id="@+id/wave"
        android:layout_width="match_parent" android:layout_height="46dp" />

    <SeekBar android:id="@+id/slider"
        android:layout_width="match_parent" android:layout_height="46dp"
        android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/timeCur" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0:00" android:textColor="#B3FFFFFF" android:textSize="12sp" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/timeDur" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0:00" android:textColor="#B3FFFFFF" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="22dp">
        <ImageView android:id="@+id/btnShuffle" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:padding="10dp" android:src="@drawable/ic_shuffle" app:tint="#C9C5DE" />
        <ImageView android:id="@+id/btnPrev" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:padding="6dp" android:src="@drawable/ic_prev" app:tint="#FFFFFF" />
        <FrameLayout android:id="@+id/btnPlay" android:layout_width="68dp" android:layout_height="68dp"
            android:layout_marginStart="6dp" android:layout_marginEnd="6dp">
            <ImageView android:id="@+id/playIcon" android:layout_width="30dp" android:layout_height="30dp"
                android:layout_gravity="center" android:src="@drawable/ic_play" />
        </FrameLayout>
        <ImageView android:id="@+id/btnNext" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:padding="6dp" android:src="@drawable/ic_next" app:tint="#FFFFFF" />
        <ImageView android:id="@+id/btnRepeat" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:padding="10dp" android:src="@drawable/ic_repeat" app:tint="#C9C5DE" />
    </LinearLayout>
</LinearLayout>
